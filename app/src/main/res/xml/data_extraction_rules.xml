<?xml version="1.0" encoding="utf-8"?>
<!--
  MetaForge holds two things that must never leave the phone: the untouched
  originals kept in filesDir/backups, and whatever API credentials the user
  entered for an optional second-opinion service. Cloud backup and device
  transfer are both refused outright rather than filtered.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
